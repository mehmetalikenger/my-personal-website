RewriteEngine on

# Redirect HTTP to HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect mehmetalikenger.tr and www.mehmetalikenger.tr to https://mehmetalikenger.com/tr
RewriteCond %{HTTP_HOST} ^(www\.)?mehmetalikenger\.tr$ [OR]

# Redirect www.x.com.tr to https://x.com/tr
RewriteCond %{HTTP_HOST} ^(www\.)?mehmetalikenger\.com\.tr$
RewriteRule ^(.*)$ https://mehmetalikenger.com/tr/ [R=301,L]

# Remove index.html from URL
RewriteCond %{THE_REQUEST} /index\.html [NC]
RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

# Optional: Redirect trailing slash to remove it (if needed)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]
